# Copy to frontend/.env. Restart `npm run dev` after any change.
# Everything here is visible in the browser: never put the Gemini key or a database password in this file.

# Node backend (login, users, drives, dashboards)
VITE_API_URL=http://localhost:3001/api

# Python services, reached through the Vite dev proxy (dev only)
QNA_SERVICE_URL=http://127.0.0.1:5000
RESUME_SERVICE_URL=http://127.0.0.1:8000
