# Local-only PostgreSQL integration-test database. Never use these values in production.
APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_TEST_DB=finxl_test
POSTGRES_TEST_USER=finxl_test
POSTGRES_TEST_PASSWORD=replace_me_test_only
POSTGRES_TEST_PORT=55432


# Use the same database name for both runtime and integration-test connections.
DATABASE_URL=postgresql+psycopg://finxl_test:replace_me_test_only@localhost:55432/finxl_test
FINXL_TEST_POSTGRES_URL=postgresql+psycopg://finxl_test:replace_me_test_only@localhost:55432/finxl_test
LLM_PROVIDER=fake
DEV_ASSESSMENT_CONTENT_MODE=fixture
DEV_ASSESSMENT_ALLOW_DRAFT=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=20
PROVIDER_OPERATION_LEASE_SECONDS=600
LEASE_RECOVERY_INTERVAL_SECONDS=30
LEASE_RECOVERY_BATCH_SIZE=100
TRANSCRIPT_RETENTION_DAYS=
REQUEST_RATE_LIMIT_COUNT=120
REQUEST_RATE_LIMIT_WINDOW_SECONDS=60
CORS_ALLOWED_ORIGINS=["https://interviewer.example.com"]
TRUSTED_HOSTS=["api.example.com"]
TRUSTED_PROXIES=[]
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ALGORITHMS=["RS256"]
JWT_JWKS_URL=
JWT_PUBLIC_KEY=
JWT_USER_ID_CLAIM=sub
JWT_ROLE_CLAIM=role
JWT_LEEWAY_SECONDS=60
