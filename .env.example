APP_NAME=AI Voice Interview Agent
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Groq is the primary LLM provider.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Deepgram remains required for speech-only candidate answers.
DEEPGRAM_API_KEY=
DEEPGRAM_LANGUAGE=en

# Kokoro runs locally. The model and voice download on first use and are cached.
KOKORO_ENABLED=true
KOKORO_VOICE=am_michael
KOKORO_SPEED=1.0
KOKORO_SAMPLE_RATE=24000
KOKORO_DEVICE=cpu

DATABASE_PATH=./data/interviews.db
SESSION_IDLE_TIMEOUT_SECONDS=900
MAX_CONCURRENT_SESSIONS_PER_IP=3
MAX_SESSION_COST_USD=5.00
# End an answer after 450 ms of silence (faster response; long answer pauses may split turns).
VAD_SILENCE_DURATION_MS=450
AUDIO_INPUT_SAMPLE_RATE=16000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
