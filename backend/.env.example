# Copy to backend/.env and fill in. Shared by Node, qna_generator and resume_optimizer.

# --- PostgreSQL (Node API + database/setup.js) ---
PGUSER=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=finxl_platform
PGPASSWORD=

# --- Node API (frontend login) ---
API_PORT=3001

# --- AI (Gemini) : used by qna_generator and resume_optimizer ---
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/

AUTH_SECRET=
# PYTHON_BIN=python

# Address the browser loads the app from (allowed by CORS)
FRONTEND_ORIGIN=http://localhost:5173

PASSWORD_VIEW_KEY=
